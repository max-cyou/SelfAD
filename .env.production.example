# Copy to .env for docker compose. Never commit the populated .env file.
SELFAD_POSTGRES_USER=selfad
SELFAD_POSTGRES_PASSWORD=replace-with-a-long-random-password
SELFAD_SECRET_KEY=replace-with-at-least-32-random-characters
SELFAD_METRICS_TOKEN=replace-with-a-long-random-token

# The runner is a dedicated VM/microVM, not this Docker host.
SELFAD_RUNNER_DOCKER_HOST=tcp://runner-1.internal:2376
SELFAD_RUNNER_TLS_DIR=/srv/selfad/runner-tls

# URLs exposed through your reverse proxy.
SELFAD_PUBLIC_DOMAIN=ctf.example
SELFAD_GITEA_PUBLIC_URL=https://git.ctf.example
SELFAD_GITEA_DOMAIN=git.ctf.example
SELFAD_GITEA_SSH_DOMAIN=git.ctf.example
SELFAD_GITEA_SSH_PUBLIC_PORT=2224
SELFAD_GITEA_SSH_PORT=2224
SELFAD_WORKER_CONCURRENCY=1
