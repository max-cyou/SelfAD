# Addresses shown in Gitea clone links. For LAN access, replace localhost with
# the host's LAN IP or DNS name before the first start.
SELFAD_GITEA_PUBLIC_URL=http://localhost:8929
SELFAD_GITEA_DOMAIN=localhost
SELFAD_GITEA_SSH_DOMAIN=localhost

# Host ports. Change the values before startup if they are already occupied.
SELFAD_HTTP_PORT=8000
SELFAD_GITEA_HTTP_PORT=8929
SELFAD_GITEA_SSH_PORT=2224

# Domain / reverse-proxy mode. Enable the single line below when nginx or
# another TLS proxy on the Docker host fronts the panel on a domain. The
# trusted proxy address already defaults to the fixed Compose network gateway
# (172.31.201.1), so a proxy on the host needs no extra settings. Point the
# Gitea clone URLs at the domain and keep the HTTP ports loopback-only so the
# proxy cannot be bypassed.
#SELFAD_TRUST_PROXY_HEADERS=true
#SELFAD_GITEA_PUBLIC_URL=https://git.ctf.example
#SELFAD_GITEA_DOMAIN=git.ctf.example
#SELFAD_GITEA_SSH_DOMAIN=ctf.example
#SELFAD_HTTP_BIND=127.0.0.1
#SELFAD_GITEA_HTTP_BIND=127.0.0.1

# Set together with the proxy above: marks the session cookie Secure so
# browsers only send it over HTTPS. Leave disabled while using plain
# http://IP:8000 access, otherwise sign-in stops working.
#SELFAD_SECURE_COOKIES=true
