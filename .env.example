# Addresses shown in Gitea clone links. For LAN access, replace localhost with
# the host's LAN IP or DNS name before the first start.
SELFAD_GITEA_PUBLIC_URL=http://localhost:8929
SELFAD_GITEA_DOMAIN=localhost
SELFAD_GITEA_SSH_DOMAIN=localhost

# Host ports. Change the values before startup if they are already occupied.
SELFAD_HTTP_PORT=8000
SELFAD_GITEA_HTTP_PORT=8929
SELFAD_GITEA_SSH_PORT=2224

# Domain / reverse-proxy mode. When nginx, Caddy or another proxy on the Docker
# host terminates TLS for a domain in front of the published ports, enable
# forwarded-header trust and name the proxy address as the container sees it
# (for a proxy on the host this is the compose network gateway; find it with
# `docker network inspect selfad_default`). Without this the panel renders
# http:// links behind https and the browser blocks them via CSP.
# Also point the Gitea clone URLs at the domain and keep the HTTP ports
# loopback-only so the proxy cannot be bypassed.
#SELFAD_TRUST_PROXY_HEADERS=true
#SELFAD_TRUSTED_PROXY_HOSTS=192.168.0.1
#SELFAD_GITEA_PUBLIC_URL=https://git.ctf.example
#SELFAD_GITEA_DOMAIN=git.ctf.example
#SELFAD_GITEA_SSH_DOMAIN=ctf.example
#SELFAD_HTTP_BIND=127.0.0.1
#SELFAD_GITEA_HTTP_BIND=127.0.0.1
