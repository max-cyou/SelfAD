#!/bin/bash

exec 2>&1
set -euo pipefail

export SELFAD_DATA_DIR="${SELFAD_DATA_DIR:-/data/selfad/data}"
export SELFAD_GITEA_INTERNAL_URL="${SELFAD_GITEA_INTERNAL_URL:-http://127.0.0.1:8929}"
export SELFAD_GITEA_PUBLIC_URL="${SELFAD_GITEA_PUBLIC_URL:-http://localhost:8929}"
export SELFAD_GITEA_TOKEN_FILE="${SELFAD_GITEA_TOKEN_FILE:-${SELFAD_DATA_DIR}/gitea_token}"
export SELFAD_GITEA_VERIFY_TLS="${SELFAD_GITEA_VERIFY_TLS:-false}"
export SELFAD_RUNNER_DOCKER_HOST="${SELFAD_RUNNER_DOCKER_HOST:-unix:///run/selfad-docker/docker.sock}"
export DOCKER_HOST="${SELFAD_RUNNER_DOCKER_HOST}"
if [[ "${SELFAD_RUNNER_TLS_VERIFY:-false}" =~ ^(1|true|yes|on)$ ]]; then
    export DOCKER_TLS_VERIFY=1
fi
if [[ -n "${SELFAD_RUNNER_CERT_PATH:-}" ]]; then
    export DOCKER_CERT_PATH="${SELFAD_RUNNER_CERT_PATH}"
fi

readonly gitea_url="${SELFAD_GITEA_INTERNAL_URL}"
readonly token_file="${SELFAD_GITEA_TOKEN_FILE}"
readonly config_file="/data/gitea/conf/app.ini"
readonly password_file="/data/selfad/secrets/gitea_admin_password"
readonly service_username="selfad-system"

cd /app

attempt=0
until curl --fail --silent "${gitea_url}/api/healthz" >/dev/null; do
    attempt=$((attempt + 1))
    if (( attempt % 12 == 1 )); then
        echo "Waiting for the local Gitea instance..."
    fi
    sleep 5
done

token_is_valid=false
if [[ -s "${token_file}" ]]; then
    current_token=$(<"${token_file}")
    authenticated_user=$(curl \
        --fail \
        --silent \
        --header "Authorization: token ${current_token}" \
        "${gitea_url}/api/v1/user" \
        2>/dev/null \
        | python3 -c 'import json, sys; print(json.load(sys.stdin).get("login", ""))' \
        2>/dev/null || true)
    if [[ "${authenticated_user}" == "${service_username}" ]]; then
        token_is_valid=true
    fi
fi

if [[ "${token_is_valid}" != true ]]; then
    if ! su-exec git:git /usr/local/bin/gitea \
        --config "${config_file}" \
        admin user list \
        | awk '$2 == "root" { found = 1 } END { exit !found }'; then
        admin_password=$(<"${password_file}")
        su-exec git:git /usr/local/bin/gitea \
            --config "${config_file}" \
            admin user create \
            --username root \
            --password "${admin_password}" \
            --email root@localhost \
            --admin \
            --must-change-password=false
        unset admin_password
    fi

    if ! su-exec git:git /usr/local/bin/gitea \
        --config "${config_file}" \
        admin user list \
        | awk -v username="${service_username}" \
            '$2 == username { found = 1 } END { exit !found }'; then
        service_password=$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))')
        su-exec git:git /usr/local/bin/gitea \
            --config "${config_file}" \
            admin user create \
            --username "${service_username}" \
            --password "${service_password}" \
            --email "selfad-system@localhost" \
            --admin \
            --must-change-password=false
        unset service_password
    fi

    current_token=$(su-exec git:git /usr/local/bin/gitea \
        --config "${config_file}" \
        admin user generate-access-token \
        --username "${service_username}" \
        --token-name "selfad-internal-$(date +%s)" \
        --scopes all \
        --raw)

    umask 077
    temporary_token_file="${token_file}.new"
    printf '%s' "${current_token}" > "${temporary_token_file}"
    chown selfad:selfad "${temporary_token_file}"
    chmod 0400 "${temporary_token_file}"
    mv -f "${temporary_token_file}" "${token_file}"
fi

echo "Local Gitea API access configured. Starting SelfAD."

if docker info >/dev/null 2>&1; then
    echo "Configured Docker runner is ready."
else
    echo "Configured Docker runner is unavailable; starting the control plane in degraded mode."
fi
exec su-exec selfad:selfad \
    /opt/selfad/venv/bin/uvicorn \
    main:app \
    --host 0.0.0.0 \
    --port "${SELFAD_PORT:-8000}"
