# Sanitized copy of the J2W Autumn CTF SelfAD environment.
# Generate new values for every replace-with-* entry before starting.
SELFAD_POSTGRES_USER=selfad
SELFAD_POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
SELFAD_SECRET_KEY=replace-with-openssl-rand-hex-32
SELFAD_METRICS_TOKEN=replace-with-openssl-rand-hex-32
SELFAD_SETUP_TOKEN=replace-with-openssl-rand-hex-32

# The event used the single-VPS override and its bundled privileged runner.
# This must remain false for that profile.
SELFAD_PUBLIC_EVENT_MODE=false
SELFAD_RUNNER_DOCKER_HOST=unix:///run/selfad-docker/docker.sock
# Required by the base production file; the single-VPS override does not turn
# the bundled runner into a physically dedicated host.
SELFAD_RUNNER_ISOLATION=dedicated-host
SELFAD_RUNNER_TLS_DIR=/srv/selfad/runner-pwf-tls

# Actual public endpoints used by the deployment.
SELFAD_PUBLIC_DOMAIN=ctf.jmp2win.xyz
SELFAD_GITEA_PUBLIC_URL=https://git.ctf.jmp2win.xyz
SELFAD_GITEA_DOMAIN=git.ctf.jmp2win.xyz
SELFAD_GITEA_SSH_DOMAIN=git.ctf.jmp2win.xyz
SELFAD_GITEA_SSH_PUBLIC_PORT=2224
SELFAD_GITEA_SSH_PORT=2224

# Tuned for the 20-core / 48 GiB event host.
SELFAD_WORKER_CONCURRENCY=8
